{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ranking": {
    // MEDIDOS (MET-524, T11 reexecutada contra Postgres+pgvector real, corpus vetorizado com
    // qwen3-embedding-0.6b — ver eval/README.md "Grid de calibração e limiares"): único ponto do
    // grid de 18 elegível a L1 (hitRate@3=1,00) e L3 (100% da ordem) simultaneamente, pela regra de
    // escolha declarada na spec (spec.md:177-182: descartar quem viola L1/L3 -> maior
    // meanPrecision@5 -> empate em 0,02 pelo mais simples). meanPrecision@5 medido neste ponto =
    // 0,41 (piso L2 derivado dele via ADR-005 -> GoldenSetEvalTests.L2Threshold = 0,40).
    // project/adr/ADR-005-piso-l2-baixado-e-pesos-do-ranking-calibrados.md (repo do harness). Trocar
    // estes números exige ADR nova que supersede a ADR-003/ADR-005 — inclusive "só ajustar um peso".
    "SemanticWeight": 0.9,
    "ProximityWeight": 0.1,
    "DistanceDecayKm": 5,
    // 0 = corte desligado (mantido pela ADR-005): a perda de meanPrecision@5 medida não é ruído
    // geográfico entrando por proximidade (as consultas sem localização têm o mesmo precision@5 em
    // todo o grid) — é excesso de candidatos de OUTRAS especialidades semanticamente próximos.
    // Cortar pelo fator semântico não tem evidência de resolver isso; ligar o corte sem essa
    // evidência é gatilho de revisão da ADR-005, não decisão tomada aqui.
    "MinSemanticScore": 0.0
  },
  "Search": {
    // MET-479/T6, design.md §2. CandidateLimit > corpus de propósito (D7): v1 é exato, nada é
    // cortado antes do ranking em C#.
    "CandidateLimit": 200,
    "DefaultResultLimit": 10,
    "MaxResultLimit": 50,
    "ExampleQueryLimit": 8,
    // spec.md "Contrato API ↔ Frontend": q é "2–200 caracteres após trim" (achado do review da T6 —
    // o piso não estava implementado).
    "MinQueryLength": 2,
    "MaxQueryLength": 200
  }
  // Nenhuma seção "Embeddings" aqui de propósito (achado do review da T6): o default de
  // Embeddings:Provider para esta API vive em CÓDIGO (Program.cs), não neste arquivo — appsettings.json
  // é Content do Sdk.Web e o MSBuild o copia para a saída de qualquer projeto que referencie
  // Prumo.Api, inclusive src/Prumo.Seed, que precisa continuar SEM nenhum default silencioso.
}
