{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ranking": {
    // VALORES PROVISÓRIOS (MET-479/T1) até a calibração da MET-479/T11 (spec,
    // "Medição do Case"): o valor final sai do grid de 18 pontos medido contra o golden set, com a
    // regra de escolha declarada na spec. Trocar estes números depois do congelamento (T12) exige
    // uma ADR nova que supersede a ADR-003 — inclusive "só ajustar um peso".
    // T11 RODOU (2026-08-10) contra vetores reais e NÃO fechou a régua: nenhum dos 18 pontos do
    // grid satisfaz L1 (hitRate@3=1,00) e L3 simultaneamente — ver eval/README.md, "Grid de
    // calibração e limiares". Nenhum peso foi escolhido; estes valores continuam PROVISÓRIOS,
    // inalterados, aguardando decisão do dono (ADR).
    "SemanticWeight": 0.7,
    "ProximityWeight": 0.3,
    "DistanceDecayKm": 10,
    // 0 = corte desligado até a calibração (T11): nunca esconder resultado por default.
    "MinSemanticScore": 0.0
  },
  "Search": {
    // MET-479/T6, design.md §2. CandidateLimit > corpus de propósito (D7): v1 é exato, nada é
    // cortado antes do ranking em C#.
    "CandidateLimit": 200,
    "DefaultResultLimit": 10,
    "MaxResultLimit": 50,
    "ExampleQueryLimit": 8,
    // spec.md "Contrato API ↔ Frontend": q é "2–200 caracteres após trim" (achado do review da T6 —
    // o piso não estava implementado).
    "MinQueryLength": 2,
    "MaxQueryLength": 200
  }
  // Nenhuma seção "Embeddings" aqui de propósito (achado do review da T6): o default de
  // Embeddings:Provider para esta API vive em CÓDIGO (Program.cs), não neste arquivo — appsettings.json
  // é Content do Sdk.Web e o MSBuild o copia para a saída de qualquer projeto que referencie
  // Prumo.Api, inclusive src/Prumo.Seed, que precisa continuar SEM nenhum default silencioso.
}
