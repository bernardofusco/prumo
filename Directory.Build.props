<Project>

  <!--
    Fonte única de verdade do TFM e das flags de qualidade do backend .NET (project/development-rules.md).
    Nenhum .csproj sob esta árvore deve repetir TargetFramework/Nullable/ImplicitUsings.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
